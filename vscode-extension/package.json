{
  "name": "shopware-lsp",
  "displayName": "Shopware Language Server",
  "description": "Shopware and Symfony Support for Visual Studio Code",
  "version": "0.2.0",
  "publisher": "shopware",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#00ADEF",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "shopware",
    "symfony",
    "twig"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:xml",
    "onLanguage:twig",
    "onLanguage:vue",
    "onLanguage:yaml",
    "onLanguage:dotenv",
    "onLanguage:dockerfile",
    "workspaceContains:.env",
    "workspaceContains:Dockerfile",
    "onLanguage:scss",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shopwareLabs/shopware-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/shopwareLabs/shopware-lsp/issues"
  },
  "pricing": "Free",
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Shopware Language Server",
      "properties": {
        "shopwareLSP.activationMode": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Start only when the workspace root is detected as Shopware or Symfony, or contains .config/shopware/lsp.yaml.",
            "Always start for this workspace and explicitly allow unsupported project roots.",
            "Never start the language server or expose its MCP server for this workspace."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Controls whether Shopware LSP starts for this workspace folder. Auto avoids starting or indexing in unrelated PHP projects."
        },
        "shopwareLSP.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Shopware Language Server executable. If empty, the extension will try to find the server automatically."
        },
        "shopwareLSP.phpExecutable": {
          "type": "string",
          "default": "php",
          "description": "PHP executable used by Symfony command code lenses."
        },
        "shopwareLSP.memoryLimitMiB": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "scope": "machine-overridable",
          "description": "Optional soft Go memory limit for the language-server process in MiB. Zero uses the server's balanced GC policy. A value of 512 is a low-memory starting point for large Shopware workspaces; lower values may increase indexing CPU substantially."
        },
        "shopwareLSP.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Expose the Shopware MCP tools to VS Code AI clients for this workspace folder. VS Code starts a separate language-server process lazily when an MCP tool is used."
        },
        "shopwareLSP.mcp.tools": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": false,
          "properties": {
            "shopware_diagnostics": {"type": "boolean"},
            "shopware_code_actions": {"type": "boolean"},
            "shopware_apply_code_action": {"type": "boolean"},
            "shopware_hover": {"type": "boolean"},
            "shopware_definition": {"type": "boolean"},
            "shopware_references": {"type": "boolean"},
            "shopware_workspace_symbols": {"type": "boolean"},
            "shopware_scaffold_catalog": {"type": "boolean"},
            "shopware_scaffold": {"type": "boolean"},
            "shopware_entity_schema_bootstrap": {"type": "boolean"},
            "shopware_entity_schema_field_types": {"type": "boolean"},
            "shopware_entity_schema_search": {"type": "boolean"},
            "shopware_entity_schema_load": {"type": "boolean"},
            "shopware_entity_schema_preview": {"type": "boolean"},
            "shopware_entity_schema_apply": {"type": "boolean"},
            "shopware_entity_schema_reconcile": {"type": "boolean"}
          },
          "description": "Local overrides for individual Shopware MCP tools. Omitted tools remain enabled."
        },
        "shopwareLSP.phpExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional PHP runtime extensions whose generated stubs should be loaded (for example redis or imagick). Composer ext-* requirements are detected automatically."
        },
        "shopwareLSP.disabledPhpExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "PHP runtime extensions known to be unavailable. Their stubs are excluded and uses receive a targeted diagnostic."
        },
        "shopwareLSP.shopwareTargetVersion": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "pattern": "^$|^v?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$",
          "description": "Optional Shopware target version for migration diagnostics, for example 6.8. Leave empty to detect the installed or platform checkout version."
        },
        "shopwareLSP.features": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Local overrides for LSP capabilities such as completion, hover, codeLens, and semanticTokens. Use 'Shopware: Configure Language Server…' for a searchable editor."
        },
        "shopwareLSP.indexing.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable persistent workspace indexing. Changing this structural setting requires a language-server restart."
        },
        "shopwareLSP.indexing.maxFileSizeMiB": {
          "type": "integer",
          "default": 8,
          "minimum": 0,
          "maximum": 4095,
          "scope": "resource",
          "description": "Maximum source-file size included in persistent indexing, in MiB. Set to 0 to disable this configurable limit; the parser's 32-bit source-range limit still applies. Changing this structural setting requires a language-server restart."
        },
        "shopwareLSP.indexing.exclude": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "description": "Workspace-relative glob patterns excluded from persistent indexing. Open documents remain available for document-local language features. Changing this structural setting requires a language-server restart."
        },
        "shopwareLSP.domains": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Local domain overrides, for example symfony.doctrine, administration, twig, or scss. Changing domains requires a restart."
        },
        "shopwareLSP.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable all Shopware LSP diagnostics."
        },
        "shopwareLSP.diagnostics.inspections": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Enable or disable complete diagnostic inspections by stable inspection ID."
        },
        "shopwareLSP.diagnostics.rules": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "enum": [
              "off",
              "hint",
              "information",
              "warning",
              "error"
            ]
          },
          "description": "Disable or override severity for individual diagnostics by stable rule ID."
        },
        "shopwareLSP.diagnostics.overrides": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Path-scoped diagnostic overrides. Patterns are relative to the workspace folder; later matching entries win.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["files"],
            "properties": {
              "files": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "enabled": {"type": "boolean"},
              "inspections": {
                "type": "object",
                "additionalProperties": {"type": "boolean"}
              },
              "rules": {
                "type": "object",
                "additionalProperties": {
                  "enum": ["off", "hint", "information", "warning", "error"]
                }
              }
            }
          }
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "shopwareLSP.mcp",
        "label": "Shopware Language Server"
      }
    ],
    "commands": [
      {
        "command": "shopwareLSP.restart",
        "title": "Restart Shopware Language Server"
      },
      {
        "command": "shopwareLSP.forceReindex",
        "title": "Shopware: Force Reindex"
      },
      {
        "command": "shopwareLSP.configure",
        "title": "Shopware: Configure Language Server…"
      },
      {
        "command": "shopwareLSP.openConfiguration",
        "title": "Shopware: Open Configuration…"
      },
      {
        "command": "shopware.createFile",
        "title": "Shopware: New File…"
      },
      {
        "command": "shopware.insertUuid",
        "title": "Shopware: Insert UUID"
      },
      {
        "command": "shopware.symfony.runConsoleCommandPicker",
        "title": "Symfony: Run Console Command…"
      },
      {
        "command": "shopware.symfony.browseRoutes",
        "title": "Symfony: Browse Routes…"
      },
      {
        "command": "shopware.symfony.browseProfilerRequests",
        "title": "Symfony: Browse Profiler Requests…"
      },
      {
        "command": "shopware.symfony.browseDoctrineEntities",
        "title": "Symfony: Browse Doctrine Entities…"
      },
      {
        "command": "shopware.symfony.browseFormTypes",
        "title": "Symfony: Browse Form Types…"
      },
      {
        "command": "shopware.symfony.locateService",
        "title": "Symfony: Locate Service…"
      },
      {
        "command": "shopware.symfony.generateServiceDefinitions",
        "title": "Symfony: Generate Service Definitions…"
      },
      {
        "command": "shopware.symfony.browseTwigExtensions",
        "title": "Symfony: Browse Twig Extensions…"
      },
      {
        "command": "shopware.symfony.analyzeTwigTemplateUsages",
        "title": "Symfony: Analyze Twig Template Usages…"
      },
      {
        "command": "shopware.symfony.browseTwigComponents",
        "title": "Symfony: Browse Twig Components…"
      },
      {
        "command": "shopware.symfony.analyzeTwigTemplateVariables",
        "title": "Symfony: Analyze Twig Template Variables…"
      },
      {
        "command": "shopware.symfony.twigVariables",
        "title": "Symfony: Browse Current Twig Variables…"
      },
      {
        "command": "shopware.insertSnippet",
        "title": "Shopware: Insert Snippet"
      },
      {
        "command": "shopware.createSnippetFromSelection",
        "title": "Shopware: Create Snippet from Selection"
      },
      {
        "command": "shopware.twig.extendBlock",
        "title": "Shopware: Extend Twig Block"
      },
      {
        "command": "shopware.twig.showBlockDiff",
        "title": "Shopware: Show Twig Block Difference"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "explorerResourceIsFolder",
          "command": "shopware.createFile",
          "group": "navigation@89"
        }
      ],
      "editor/context": [
        {
          "command": "shopware.insertUuid",
          "group": "shopware"
        },
        {
          "when": "resourceLangId == twig",
          "command": "shopware.insertSnippet",
          "group": "shopware"
        },
        {
          "when": "resourceLangId == twig && editorHasSelection",
          "command": "shopware.createSnippetFromSelection",
          "group": "shopware"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": "**/.config/shopware/lsp.yaml",
        "url": "./dist/shopware-lsp.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "php",
        "path": "./snippets/php.json"
      },
      {
        "language": "xml",
        "path": "./snippets/config-xml.json"
      }
    ]
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "test:entity-designer": "npm run compile && node --test test/entityDesignerWebview.test.js",
    "test:configuration": "npm run compile && node --test test/configuration.test.js",
    "test:mcp": "npm run compile && node --test test/mcpServer.test.js",
    "test:project-detection": "npm run compile && node --test test/projectDetection.test.js",
    "test:language-configuration": "npm run compile && node --test test/languageConfiguration.test.js",
    "test:workspace-roots": "npm run compile && node --test test/workspaceRoots.test.js",
    "test:workspace-clients": "npm run compile && node --test test/workspaceClientManager.test.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "vscode:prepublish": "npm run package",
    "package": "npm run check-types && node esbuild.js --production"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^16.18.34",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.1.3"
  }
}
