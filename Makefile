# The language server is the Rust crate swlsp-cli (crates/).
#
# Toolchains: Rust from rust-toolchain.toml (rustup picks it up), Node.js 24
# for the VS Code extension.

CARGO        ?= cargo
NPM          ?= npm
VSCODE_DIR   := editors/vscode
ZED_DIR      := editors/zed

.PHONY: all
all: build vscode-build

## Rust server ---------------------------------------------------------------

# Release binary at target/release/shopware-lsp. Set SHOPWARE_LSP_VERSION to
# embed a version (defaults to "dev").
.PHONY: build
build:
	$(CARGO) build --locked --release -p swlsp-cli --bin shopware-lsp

.PHONY: rust-build
rust-build:
	$(CARGO) build --locked --workspace

.PHONY: rust-test
# Everything `cargo test` builds except doc-tests: the crates have none, and
# rustdoc costs ~9 s for 96 empty doc-test runs.
RUST_TEST_TARGETS := --lib --bins --tests --examples

rust-test:
	$(CARGO) test --locked --workspace $(RUST_TEST_TARGETS)

.PHONY: rust-clippy
rust-clippy:
	$(CARGO) clippy --locked --workspace --all-targets -- -D warnings

.PHONY: rust-fmt
rust-fmt:
	$(CARGO) fmt --all

.PHONY: rust-fmt-check
rust-fmt-check:
	$(CARGO) fmt --all --check

.PHONY: rust-test-integration-compile
rust-test-integration-compile:
	$(CARGO) clippy --locked -p swlsp-app --features integration --all-targets -- -D warnings

.PHONY: rust-check
rust-check: rust-fmt-check rust-clippy rust-test rust-test-integration-compile

## Third-party notices -------------------------------------------------------

# THIRD_PARTY_NOTICES.md (embedded in the binary, `shopware-lsp licenses`) is
# generated by cargo-about 0.9.2 from about.toml and about.hbs. Install it with
# `cargo install --locked --features cli cargo-about@0.9.2`, or point
# CARGO_ABOUT at a `cargo-about` binary. Run `make notices` after changing
# dependencies; CI fails when the committed file is stale.
CARGO_ABOUT ?= $(CARGO) about

.PHONY: notices
notices:
	$(CARGO) fetch --locked
	$(CARGO_ABOUT) generate --frozen --fail -m crates/cli/Cargo.toml -o THIRD_PARTY_NOTICES.md about.hbs

.PHONY: notices-check
notices-check: notices
	git diff --exit-code -- THIRD_PARTY_NOTICES.md

## VS Code extension ---------------------------------------------------------

.PHONY: vscode-install
vscode-install:
	$(NPM) --prefix $(VSCODE_DIR) ci

.PHONY: vscode-check
vscode-check:
	$(NPM) --prefix $(VSCODE_DIR) run check-types

.PHONY: vscode-build
vscode-build:
	$(NPM) --prefix $(VSCODE_DIR) run compile

.PHONY: vscode-test
vscode-test:
	$(NPM) --prefix $(VSCODE_DIR) test

## Zed extension -------------------------------------------------------------

.PHONY: zed-check
zed-check:
	cd $(ZED_DIR) && $(CARGO) fmt --check && $(CARGO) clippy --locked --all-targets -- -D warnings

.PHONY: zed-test
zed-test:
	cd $(ZED_DIR) && $(CARGO) test --locked && python3 scripts/test-sw-action.py

.PHONY: zed-build
zed-build:
	cd $(ZED_DIR) && $(CARGO) build --locked --release --target wasm32-wasip2

.PHONY: zed-contracts
zed-contracts:
	bash $(ZED_DIR)/scripts/check-local.sh

## Full local validation -----------------------------------------------------

.PHONY: check
check: rust-check vscode-check vscode-test zed-check zed-test zed-build zed-contracts

## Release packaging ---------------------------------------------------------
#
# CI builds every target (.github/workflows/build-binaries.yml), packages the
# zip archives and checksums.txt with scripts/release/package-release.sh, and
# the VSIX files with scripts/build-vsix-release.mjs. Locally, `make release`
# builds the host binary and packages only the host VSIX into out/.

.PHONY: release
release: vscode-install
	node scripts/build-vsix-release.mjs --local

# Package prebuilt binaries laid out as target/<rust-triple>/release/
# shopware-lsp[.exe] (scripts/release/stage-binaries.sh) into dist/.
.PHONY: release-dry-run
release-dry-run:
	scripts/release/package-release.sh snapshot dist
